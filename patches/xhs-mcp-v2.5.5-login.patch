+func TestLoginPageStates(t *testing.T) {
+	binary := os.Getenv("XHS_LOGIN_TEST_BROWSER")
+	if binary == "" {
+		t.Skip("set XHS_LOGIN_TEST_BROWSER to run offline browser tests")
+	}
+	control, err := launcher.New().Bin(binary).Headless(true).Launch()
+	require.NoError(t, err)
+	browser := rod.New().ControlURL(control)
+	require.NoError(t, browser.Connect())
+	defer browser.Close()
+	cases := []struct {
+		name     string
+		body     string
+		loggedIn bool
+		wantQR   string
+	}{
+		{
+			name:     "existing login does not click button",
+			body:     `<div class="main-container"><div class="user"><div class="link-wrapper"><span class="channel">synthetic</span></div></div></div><button class="login-btn" onclick="document.body.innerHTML=''">登录</button>`,
+			loggedIn: true,
+		},
+		{
+			name:   "auto opened QR remains unchanged",
+			body:   `<img class="qrcode-img" src="data:image/png;base64,c3ludGhldGlj"><button class="login-btn" onclick="document.body.innerHTML=''">登录</button>`,
+			wantQR: "data:image/png;base64,c3ludGhldGlj",
+		},
+		{
+			name:   "normal visible login button opens QR",
+			body:   `<div class="side-bar-component login-btn" style="display:none">登录</div><button class="login-btn" onclick="this.remove();document.body.insertAdjacentHTML('beforeend','<img class=qrcode-img src=data:image/png;base64,c3ludGhldGlj>')">登录</button>`,
+			wantQR: "data:image/png;base64,c3ludGhldGlj",
+		},
+		{
+			name:   "wait for asynchronously populated QR source",
+			body:   `<img class="qrcode-img"><script>setTimeout(() => document.querySelector('.qrcode-img').src = 'data:image/png;base64,c3ludGhldGlj', 250)</script>`,
+			wantQR: "data:image/png;base64,c3ludGhldGlj",
+		},
+	}
+	for _, item := range cases {
+		t.Run(item.name, func(t *testing.T) {
+			page, err := browser.Page(proto.TargetCreateTarget{URL: "about:blank"})
+			require.NoError(t, err)
+			defer page.Close()
+			router := page.HijackRequests()
+			require.NoError(t, router.Add("*", "", func(request *rod.Hijack) {
+				request.Response.SetHeader("Content-Type", "text/html; charset=utf-8").SetBody("<html><body>" + item.body + "</body></html>")
+			}))
+			go router.Run()
+			defer router.Stop()
+			ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+			defer cancel()
+			image, loggedIn, err := NewLogin(page).FetchQrcodeImage(ctx)
+			require.NoError(t, err)
+			require.Equal(t, item.loggedIn, loggedIn)
+			require.Equal(t, item.wantQR, image)
+		})
+	}
+}
