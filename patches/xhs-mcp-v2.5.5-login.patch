+func TestLoginStatusPageStates(t *testing.T) {
+	binary := os.Getenv("XHS_LOGIN_TEST_BROWSER")
+	if binary == "" {
+		t.Skip("set XHS_LOGIN_TEST_BROWSER to run offline browser tests")
+	}
+	control, err := launcher.New().Bin(binary).Headless(true).Launch()
+	require.NoError(t, err)
+	browser := rod.New().ControlURL(control)
