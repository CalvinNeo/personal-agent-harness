+// waitLoginState waits until the page exposes either the authenticated marker
+// or a QR image. Navigate only waits for response headers, so a one-shot DOM
+// query can run before this asynchronously rendered page is ready.
+func (a *LoginAction) waitLoginState(ctx context.Context) (bool, error) {
+	pp := a.page.Context(ctx)
+	ticker := time.NewTicker(150 * time.Millisecond)
+	defer ticker.Stop()
+	for {
+		state, err := pp.Eval(`(authenticated, qr) => {
+			const user = window.__INITIAL_STATE__ && window.__INITIAL_STATE__.user;
+			const raw = user && user.userInfo;
+			const info = raw && raw.value !== undefined ? raw.value : raw;
+			const identifier = info && (info.userId || info.user_id);
+			if (document.querySelector(authenticated) ||
+				(info && info.guest === false && typeof identifier === "string" && identifier.trim())) return 1;
+			return document.querySelector(qr) ? -1 : 0;
+		}`, loginStatusSelector, loginQRSelector)
+		if err != nil {
+			if ctx.Err() != nil {
+				return false, ctx.Err()
+			}
+			return false, errors.Wrap(err, "check login page state failed")
+		}
+		switch state.Value.Int() {
+		case 1:
+			return true, nil
+		case -1:
+			return false, nil
+		}
+		select {
+		case <-ctx.Done():
+			return false, ctx.Err()
+		case <-ticker.C:
+		}
+	}
