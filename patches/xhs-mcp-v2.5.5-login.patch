+func hasLoginCookie(data []byte) bool {
+	var entries []struct {
+		Name    string  `json:"name"`
+		Value   string  `json:"value"`
+		Domain  string  `json:"domain"`
+		Expires float64 `json:"expires"`
+	}
+	if json.Unmarshal(data, &entries) != nil {
+		return false
+	}
+	for _, entry := range entries {
+		domain := strings.ToLower(strings.TrimPrefix(entry.Domain, "."))
+		if entry.Name == "web_session" && entry.Value != "" && (domain == "xiaohongshu.com" || strings.HasSuffix(domain, ".xiaohongshu.com")) && (entry.Expires <= 0 || entry.Expires > float64(time.Now().Unix())) {
+			return true
+		}
+	}
+	return false
+}
+
+func storedLoginCookies() (bool, error) {
+	data, err := cookies.NewLoadCookie(cookies.GetCookiesFilePath()).LoadCookies()
+	if errors.Is(err, os.ErrNotExist) {
+		return false, nil
+	}
+	if err != nil {
+		return false, err
+	}
+	var entries []json.RawMessage
+	if err := json.Unmarshal(data, &entries); err != nil || strings.TrimSpace(string(data)) == "null" {
+		return false, errors.New("stored session file is invalid")
+	}
+	return hasLoginCookie(data), nil
 }
 
