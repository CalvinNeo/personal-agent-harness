+	defer browser.Close()
+	cases := []struct {
+		name     string
+		body     string
+		loggedIn bool
+	}{
+		{
+			name:     "authenticated DOM marker",
+			body:     `<div class="main-container"><div class="user"><div class="link-wrapper"><span class="channel">synthetic</span></div></div></div>`,
+			loggedIn: true,
+		},
+		{
+			name:     "authenticated state without sidebar",
+			body:     `<script>window.__INITIAL_STATE__={user:{userInfo:{guest:false,userId:"synthetic-user"}}}</script>`,
+			loggedIn: true,
+		},
+		{
+			name:     "authenticated reactive state",
+			body:     `<script>window.__INITIAL_STATE__={user:{userInfo:{value:{guest:false,user_id:"synthetic-user"}}}}</script>`,
+			loggedIn: true,
+		},
+		{
+			name: "guest identifier is not authentication",
+			body: `<img class="qrcode-img"><script>window.__INITIAL_STATE__={user:{userInfo:{guest:true,userId:"synthetic-guest"}}}</script>`,
+		},
+		{
+			name: "missing identifier is not authentication",
+			body: `<img class="qrcode-img"><script>window.__INITIAL_STATE__={user:{userInfo:{guest:false}}}</script>`,
+		},
+		{
+			name:     "asynchronous authenticated state",
+			body:     `<script>setTimeout(()=>window.__INITIAL_STATE__={user:{userInfo:{guest:false,userId:"synthetic-user"}}},350)</script>`,
+			loggedIn: true,
+		},
+	}
+	for _, item := range cases {
+		t.Run(item.name, func(t *testing.T) {
+			page, err := browser.Page(proto.TargetCreateTarget{URL: "about:blank"})
+			require.NoError(t, err)
+			defer page.Close()
+			router := page.HijackRequests()
+			require.NoError(t, router.Add("*", "", func(request *rod.Hijack) {
+				request.Response.SetHeader("Content-Type", "text/html; charset=utf-8").SetBody("<html><body>" + item.body + "</body></html>")
+			}))
+			go router.Run()
+			defer router.Stop()
+			ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+			defer cancel()
+			loggedIn, err := NewLogin(page).CheckLoginStatus(ctx)
+			require.NoError(t, err)
+			require.Equal(t, item.loggedIn, loggedIn)
+		})
+	}
+	t.Run("unresolved state remains an error not logged out", func(t *testing.T) {
+		page, err := browser.Page(proto.TargetCreateTarget{URL: "about:blank"})
+		require.NoError(t, err)
+		defer page.Close()
+		router := page.HijackRequests()
+		require.NoError(t, router.Add("*", "", func(request *rod.Hijack) {
+			request.Response.SetHeader("Content-Type", "text/html; charset=utf-8").SetBody("<html><body>loading</body></html>")
+		}))
+		go router.Run()
+		defer router.Stop()
+		ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+		defer cancel()
+		loggedIn, err := NewLogin(page).CheckLoginStatus(ctx)
+		require.ErrorIs(t, err, context.DeadlineExceeded)
+		require.False(t, loggedIn)
+	})
