[Unit]
Description=Private Xianyu QR login and read-only search service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=xianyu
Group=xianyu
SupplementaryGroups=xianyu-secret
WorkingDirectory=/var/lib/xianyu/data
Environment=HOME=/var/lib/xianyu
Environment=PATH=/opt/astrbot/venv/bin:/usr/bin:/bin
Environment=XIANYU_PROFILE=/var/lib/xianyu/data/profile
Environment=XIANYU_BROWSER=/opt/astrbot-douyin-browser/chrome
Environment=XIANYU_API_TOKEN_FILE=/etc/xianyu/api-token
Environment=XIANYU_PORT=18070
UMask=0077
ExecStart=/opt/astrbot/venv/bin/python /opt/xianyu-watch/server.py
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ReadOnlyPaths=/opt/xianyu-watch /opt/astrbot /opt/astrbot-douyin-browser /etc/xianyu/api-token
ReadWritePaths=/var/lib/xianyu
MemoryAccounting=yes
MemoryHigh=700M
MemoryMax=1G
TasksMax=384

[Install]
WantedBy=multi-user.target
