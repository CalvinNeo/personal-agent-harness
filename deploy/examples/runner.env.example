# Copy to /etc/astrbot/runner.env. No provider key belongs in this process.
HARNESS_MODEL=REPLACE_WITH_MODEL_NAME
HARNESS_ASTRBOT_USER=astrbot
HARNESS_SOCKET=/run/astrbot-codex/bridge.sock
HARNESS_WORKSPACE_ROOT=/var/lib/codexrunner/workspaces
HARNESS_JOBS_ROOT=/var/lib/codexrunner/jobs
HARNESS_CODEX_HOME=/var/lib/codexrunner/codex
HARNESS_BWRAP=/opt/astrbot-codex-runner/codex-bwrap
HARNESS_IMAGE_PYTHON=/opt/astrbot/venv/bin/python
