# Copy to /etc/astrbot/model.env. Set root:astrbot and mode 0640.
# Fill locally; never add the populated file to Git.
MODEL_API_KEY=REPLACE_LOCALLY
# The intent_router planner may use a separate provider key. Keep it in this
# root-managed file and reference it from provider_sources as $MINIMAX_API_KEY.
MINIMAX_API_KEY=REPLACE_LOCALLY
